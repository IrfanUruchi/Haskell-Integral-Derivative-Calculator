cabal-version:       >=1.10
name:                integral-calculator
version:             0.1.0.0
build-type:          Simple

executable integral-calculator
  hs-source-dirs:      .
  main-is:             Main.hs
  other-modules:
      Expr
      Eval
      Pretty
      Differentiate
      Parse
      Simplify
      Integrate
      LLM

  build-depends:
      base            >= 4.14 && < 5
    , scotty          >= 0.22 && < 0.23
    , text            >= 2.0  && < 3.0
    , aeson           >= 2.0
    , bytestring
    , http-client
    , http-client-tls

  ghc-options: -threaded -rtsopts -with-rtsopts=-N

  default-language: Haskell2010
